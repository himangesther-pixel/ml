import kagglehub
import pandas as pd
from sklearn.tree import DecisionTreeClassifier
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score, classification_report
import matplotlib.pyplot as plt

# Download latest version of Titanic dataset
path = kagglehub.dataset_download("yasserh/titanic-dataset")
print("Path to dataset files:", path)

# Load and select relevant features
df = pd.read_csv(path + "/Titanic-Dataset.csv")
df = df[['Pclass', 'Age', 'Sex', 'SibSp', 'Parch', 'Fare', 'Embarked', 'Survived']]
print(df)

# Plot Age distribution
plt.hist(df['Age'], bins=30)
plt.show()

# Check missing values
print("\n--- Missing Values ---")
print(df.isna().sum())

# Handle missing values
df['Age'] = df['Age'].fillna(df['Age'].mean(), inplace=True)
df['Embarked'] = df['Embarked'].fillna(df['Embarked'].mode()[0], inplace=True)

print("\n--- Unique Embarked Values ---")
print(df['Embarked'].unique())

# Encode categorical variables
df['Sex'] = df['Sex'].map({'male': 0, 'female': 1})
df['Embarked'] = df['Embarked'].map({"S": 0, 'C': 1, 'Q': 2})
print(df)

# Train-Test Split
X_train, X_test, Y_train, Y_test = train_test_split(
    df[['Pclass', 'Age', 'Sex', 'SibSp', 'Parch', 'Fare', 'Embarked']], 
    df['Survived'], 
    test_size=0.2
)

# Model Training & Prediction
dt = DecisionTreeClassifier()
dt.fit(X_train, Y_train)
y_pred = dt.predict(X_test)

# Evaluation
print("\n--- Classification Report ---")
print(classification_report(Y_test, y_pred))

