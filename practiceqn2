from sklearn.datasets import load_iris
import pandas as pd
import seaborn as sns

# Load dataset
iris = load_iris()
X = pd.DataFrame(iris["data"])
Y = pd.DataFrame(iris["target"])

# 0 -> Sepal Length, 1 -> Sepal Width, 2 -> Petal Length, 3 -> Petal Width

# Descriptive analysis
print("--- Describe ---")
print(X.describe())

print("\n--- Mean ---")
print(X.mean())

print("\n--- Median ---")
print(X.median())

print("\n--- Mode ---")
print(X.mode().T)  # feature 2 has two modes

print("\n--- Standard Deviation ---")
print(X.std())

print("\n--- Standard Error of Mean ---")
print(X.sem())

print("\n--- 95% Confidence Interval ---")
print(f"95% Confidence Interval using z score is:\n{X.mean()+(1.96*X.sem())}")
print(f"95% Confidence Interval using z score is:\n{X.mean()-(1.96*X.sem())}")

# Correlation Matrix & Heatmap
print("\n--- Correlation Matrix ---")
corr_matrix = X.corr(method="pearson")
print(corr_matrix)
sns.heatmap(corr_matrix, annot=True)

# Covariance between petal length and sepal length
print("\n--- Covariance ---")
print(f"Covariance between length of petal and sepal is: {X[0].cov(X[2])}")

# Contingency Table
print("\n--- Contingency Table ---")
print(pd.crosstab(Y[0], Y[0]))

